# استفاده از نسخه سبک لینوکس آلپاین همراه با ابزار اجرای کد
FROM alpine:latest

# نصب ابزارهای مورد نیاز سرور
RUN apk add --no-cache curl bash

# تعیین پوشه اصلی کار در سرور
WORKDIR /app

# کپی کردن فایلهای پروژه به سرور ابری (اگر فایلی بعدا اضافه کردید)
COPY . .

# پورت پیش‌فرض برای پلتفرم‌های ابری (معمولا 7860 برای هاگینگ فیس)
EXPOSE 7860

# دستور روشن شدن سرور و اجرای یک اسکریپت ساده
CMD ["bash", "start.sh"]
